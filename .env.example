# ---- Base de données ----
POSTGRES_PASSWORD=change-moi
# Utilisé seulement hors Docker (docker-compose le calcule lui-même)
DATABASE_URL=postgres://goodplace:change-moi@localhost:5432/goodplace

# ---- Sécurité ----
# Au moins 32 caractères aléatoires : openssl rand -hex 32
JWT_SECRET=
# Cookie « Secure » (à activer en HTTPS)
COOKIE_SECURE=true
SESSION_DAYS=7

# ---- Administrateur unique ----
ADMIN_EMAIL=issam.webdeveloper@gmail.com
# Crée le compte au premier démarrage ; le modifier puis redémarrer change le mot de passe.
ADMIN_PASSWORD=

# ---- Site ----
SITE_URL=https://goodplace.ovh
SITE_NAME=GoodPlace

# ---- Emails ----
# log : les emails sont écrits dans les logs de l'API (développement)
# smtp : envoi réel (en dev avec mailpit : SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false)
MAIL_TRANSPORT=smtp
MAIL_FROM=GoodPlace <no-reply@goodplace.ovh>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- Publication ----
# Cron (6 champs, avec les secondes) du job de publication programmée
PUBLISH_CRON=0 * * * * *
NEWSLETTER_ON_PUBLISH=true
# Insère les articles initiaux si la table est vide
SEED_CONTENT=true
